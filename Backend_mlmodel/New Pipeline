# SYSTEM COMPONENT C: OFFLINE BACKGROUND FORENSICS ENGINE (SHAP LOGS)
# =====================================================================
def run_offline_forensics():
    print("\n============================================================\n"
          "         PHASE C: OFFLINE BACKGROUND LOG EXPLAINER LOOPS\n"
          "============================================================")
    if not os.path.exists(AUDIT_LOG_PATH) or os.stat(AUDIT_LOG_PATH).st_size == 0:
        print("[*] Audit triage log file queue is completely empty. No diagnostics needed.")
        return

    model = tf.keras.models.load_model(MODEL_PATH)
    with open(TOKENIZER_PATH, 'rb') as f: tokenizer = pickle.load(f)
    parser = StructuralWAFParser()

    with open(AUDIT_LOG_PATH, "r") as f: lines = f.readlines()
    
    report_file = "offline_forensic_report.txt"
    with open(report_file, "w") as r:
        r.write("=== BACKLOG FALSE POSITIVE ROOT-CAUSE AUDIT SUMMARY ===\n\n")
        for line in lines:
            if not line.strip(): continue
            ts, cls_idx, conf, payload = line.strip().split("|||", 3)
            cls_idx = int(cls_idx)
            feat = parser.extract_features([payload])
            seq_curr = pad_sequences(tokenizer.texts_to_sequences([payload]), maxlen=MAX_CHARS, padding='post')
            
            def shap_predict_bg(feat_mat):
                batch_size = feat_mat.shape[0]
                repeated_seqs = np.repeat(seq_curr, batch_size, axis=0)
                return model.predict([repeated_seqs, feat_mat], verbose=0)
                
            explainer = shap.KernelExplainer(shap_predict_bg, np.zeros((1, 42), dtype=np.float32))
            shap_val = explainer.shap_values(feat, silent=True)
            
            if isinstance(shap_val, list):
                class_shap = shap_val[cls_idx][0]
            else:
                class_shap = shap_val[0, :, cls_idx] if len(shap_val.shape) == 3 else shap_val[0]
            
            top_i = np.argsort(np.abs(class_shap))[::-1][:SHAP_TOP_FEATURE_COUNT]
            feature_lines = "\n".join(
                f"      {'└─' if rank == len(top_i) else '├─'} {rank}. "
                f"{FEATURE_NAMES[index]} ({class_shap[index]:.4f})"
                for rank, index in enumerate(top_i, start=1)
            )
            
            out_block = (f"Record: [{ts}] | Original Flag: {TARGET_NAMES[cls_idx]} ({conf}%)\n"
                         f" ├─ Source Request String: \"{payload}\"\n"
                         f" └─ Top SHAP Root-Cause Structural Explanations:\n"
                         f"{feature_lines}\n"
                         f"{'-'*75}\n")
            print(out_block)
            r.write(out_block)
            
    open(AUDIT_LOG_PATH, 'w').close() 
    print(f"[+] Forensic review complete. Persistent audit saved to: '{report_file}'")

