        with open(TOKENIZER_PATH, 'rb') as f:
            self.tokenizer = pickle.load(f)
        print(f"[+] Operational Security Core Injected: Using '{target_model}'")

    def _canonicalize_payload(self, payload_string):
        current = str(payload_string).strip()
        max_depth = 5
        
        for _ in range(max_depth):
            previous = current
            current = unicodedata.normalize('NFKC', current)
            current = urllib.parse.unquote(current)
            current = html.unescape(current)
            
            # Extract and decode continuous long hex strings
            long_hex_match = re.search(r'\b(?:0x)?([0-9a-fA-F]{4,})\b', current)
            if long_hex_match:
                hex_str = long_hex_match.group(1)
                if len(hex_str) % 2 == 0:
                    try:
                        decoded_hex = bytes.fromhex(hex_str).decode('utf-8', errors='ignore')
                        if decoded_hex.strip():
                            current = current.replace(long_hex_match.group(0), decoded_hex)
                    except Exception:
                        pass

            # Decode individual isolated hex tokens
            current = re.sub(r'(?:\\x|0x)([0-9a-fA-F]{2})', lambda m: chr(int(m.group(1), 16)), current)
                        
            # Decode octal sequences
            octal_matches = re.findall(r'\\([0-7]{3})', current)
            for match in octal_matches:
                try:
                    current = current.replace(f"\\{match}", chr(int(match, 8)))
                except Exception:
                    continue

            # Extract and analyze Base64 strings
            b64_matches = re.findall(r'\b[A-Za-z0-9+/]{4,}={0,2}\b', current)
            for match in b64_matches:
                try:
                    decoded_b64 = base64.b64decode(match).decode('utf-8', errors='ignore')
                    if any(tag in decoded_b64.lower() for tag in ['<', '>', 'script', 'select', 'union', 'where', 'http']):
                        current = current.replace(match, decoded_b64)
                except Exception:
                    continue
                    
            if current == previous:
                break
                
        return current

    def _is_dangerous_ssrf_host(self, url_string):
        try:
            if not url_string.lower().startswith(('http://', 'https://')):
                parsed_url = urllib.parse.urlparse('http://' + url_string)
            else:
                parsed_url = urllib.parse.urlparse(url_string)
            hostname = parsed_url.hostname
            if not hostname:
                hostname = url_string.split('/')[0].split('?')[0].split(':')[0]
            ip_obj = ipaddress.ip_address(hostname)
            return ip_obj.is_private or ip_obj.is_loopback or ip_obj.is_link_local
        except Exception:
            return False

    def _is_ssrf_request(self, payload_string):
        if REAL_SSRF_SYNTAX.search(payload_string):
            return True

        candidate = payload_string.strip()
        if candidate.lower().startswith(('http://', 'https://')):
            return self._is_dangerous_ssrf_host(candidate)
        return False

    def inspect_traffic(self, payload_string):
        if not isinstance(payload_string, str) or not payload_string.strip():
            raise ValueError("Payload must be a non-empty string.")
        
        # STEP 1: PRE-INFERENCE DE-OBFUSCATION
        normalized = self._canonicalize_payload(payload_string)
        
        feat = self.parser.extract_features([normalized])
        seq = pad_sequences(self.tokenizer.texts_to_sequences([normalized]), maxlen=MAX_CHARS, padding='post')
        
        pred_probs = self.model.predict([seq, feat], verbose=0)[0]
        ml_predicted_idx = int(np.argmax(pred_probs))
        ai_pred = TARGET_NAMES[ml_predicted_idx]
        ai_conf = float(pred_probs[ml_predicted_idx] * 100)
        
        final_verdict = ai_pred
        override_triggered = False
        validation_reason = "The model prediction passed deterministic validation."

        # STEP 2: HARDENED DUAL-SIDED VALIDATION RING
        if ai_pred == 'SQLi' and not REAL_SQLI_SYNTAX.search(normalized):
            final_verdict = 'Benign'; override_triggered = True
            validation_reason = "The SQL injection prediction did not match the required SQL syntax."
        elif ai_pred == 'SSRF' and not self._is_ssrf_request(normalized):
            final_verdict = 'Benign'; override_triggered = True
            validation_reason = "The SSRF prediction did not match a URL or private-network destination."
        elif ai_pred == 'XSS' and not REAL_XSS_SYNTAX.search(normalized):
            final_verdict = 'Benign'; override_triggered = True
            validation_reason = "The XSS prediction did not match executable markup or script syntax."
        elif ai_pred == 'Benign':
            if REAL_SQLI_SYNTAX.search(normalized):
                final_verdict = 'SQLi'; override_triggered = True
                validation_reason = "SQL injection syntax overrode a benign model prediction."
            elif self._is_ssrf_request(normalized):
                final_verdict = 'SSRF'; override_triggered = True
                validation_reason = "A private-network destination or SSRF pattern overrode a benign model prediction."
            elif REAL_XSS_SYNTAX.search(normalized) and any(x in normalized.lower() for x in ['<', '>', 'script', 'onload', 'onerror', 'charcode']):
                final_verdict = 'XSS'; override_triggered = True
                validation_reason = "Executable script syntax overrode a benign model prediction."

        if self.verbose:
            print(f"\nPayload Evaluated: \"{payload_string}\"")
            if normalized != payload_string:
                print(f" ├─ De-obfuscated Stream: \"{normalized}\"")
            
        if override_triggered:
            if self.verbose:
                print(f" ├─ ML Prediction Model Alert: {ai_pred} ({pred_probs[np.argmax(pred_probs)]*100:.2f}%)")
                print(" ├─ [CIRCUIT BREAKER OVERRIDE]: Conflicting structural parameters. Re-routing payload...")
            with open(AUDIT_LOG_PATH, "a") as f:
                f.write(f"{datetime.now().isoformat()}|||{ml_predicted_idx}|||{ai_conf:.2f}|||{payload_string}\n")

        final_confidence = (
            100.0 if override_triggered and final_verdict != "Benign"
            else float(pred_probs[TARGET_NAMES.index(final_verdict)] * 100)
        )

        if self.verbose:
            print(f" └─ RUNTIME ROUTING DECISION: ──> **{final_verdict}** (Final Status Confirmation)")
        
        # STEP 3: INTEGRATED SHAP COMPUTATION LOOP
        shap_explanations = {}
        if self.enable_shap:
            if shap is None:
                raise RuntimeError("SHAP is enabled but the shap package is not installed.")

            if self.verbose:
                print("\n    🔬 [INLINE SHAP DEEP ANALYSIS FOR CURRENT PAYLOAD]:")

            def shap_predict_dynamic(feat_mat):
                batch_size = feat_mat.shape[0]
                repeated_seqs = np.repeat(seq, batch_size, axis=0)
                return self.model.predict([repeated_seqs, feat_mat], verbose=0)
            
            explainer = shap.KernelExplainer(shap_predict_dynamic, np.zeros((1, 42), dtype=np.float32))
            shap_val = explainer.shap_values(feat, nsamples=SHAP_NSAMPLES, silent=True)
            
            if isinstance(shap_val, list):
                class_shap = shap_val[ml_predicted_idx][0]
            else:
                class_shap = shap_val[0, :, ml_predicted_idx] if len(shap_val.shape) == 3 else shap_val[0]

            top_i = np.argsort(np.abs(class_shap))[::-1][:SHAP_TOP_FEATURE_COUNT]
            for rank, i in enumerate(top_i):
                feature_name = FEATURE_NAMES[i]
                feature_impact = float(class_shap[i])
                shap_explanations[feature_name] = feature_impact
                if self.verbose:
                    print(f"      └─ Top {rank+1}: {feature_name} (Impact Magnitude: {feature_impact:.4f})")

        # STEP 4: FORENSIC REPORT GENERATION
        if self.enable_stix and final_verdict != "Benign":
            if self.verbose:
                print("    [*] Auto-generating execution verification forensic report...")
            report_file = self.orchestrator.serialize_threat_report(payload_string, final_verdict, ai_conf, shap_explanations)
            if report_file and self.verbose:
                print(f"    [+] Forensic STIX asset written to workspace disk as: '{report_file}'")

        return {
            "original_payload": payload_string,
            "normalized_payload": normalized,
            "ml_prediction": ai_pred,
            "ml_confidence": ai_conf,
            "probabilities": {
                name: float(probability * 100)
                for name, probability in zip(TARGET_NAMES, pred_probs)
            },
            "final_verdict": final_verdict,
            "final_confidence": final_confidence,
            "overridden": override_triggered,
            "validation_reason": validation_reason,
            "shap_explanations": shap_explanations,
        }

