    def serialize_threat_report(self, payload_string, threat_type, confidence_score, shap_explanations=None):
        from stix2 import AttackPattern, Bundle, Identity, Indicator, Relationship

        m_data = self._get_detailed_mitre_context(payload_string, threat_type)
        if not m_data: return None

        safe_str = payload_string.replace("'", "\\'")
        shap_text = ""
        if shap_explanations:
            shap_text = " | Top Features: " + ", ".join([f"{k} ({v:.4f})" for k, v in shap_explanations.items()])

        indicator = Indicator(
            name=f"WAF-Detected-{threat_type}-{m_data['technique_id']}",
            description=f"Confidence: {confidence_score:.2f}%. {m_data['desc']}{shap_text}",
            pattern=f"[network-traffic:extension.'http-request-ext'.body MATCHES '{safe_str}']",
            pattern_type="stix"
        )
        
        attack_pattern = AttackPattern(
            name=m_data["name"],
            description=m_data["desc"],
            external_references=[
                {
                    "source_name": "mitre-attack",
                    "external_id": m_data["technique_id"],
                    "url": f"https://attack.mitre.org/techniques/{m_data['technique_id'].replace('.', '/')}/"
                },
                {
                    "source_name": "capec",
                    "external_id": m_data["sub_id"],
                    "url": f"https://capec.mitre.org/data/definitions/{m_data['sub_id'].split('-')[1]}.html"
                }
            ]
        )
        
        relationship = Relationship(relationship_type="indicates", source_ref=indicator.id, target_ref=attack_pattern.id)
        identity = Identity(name="Corporate-Hybrid-WAF-Cluster", identity_class="organization")
        bundle = Bundle(objects=[identity, indicator, attack_pattern, relationship])
        
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"stix_{threat_type}_{m_data['technique_id']}_{timestamp}.json"
        with open(filename, "w") as f:
            f.write(bundle.serialize(pretty=True))
        return filename

